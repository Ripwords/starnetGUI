{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "starnetGUI",
  "version": "2.0.0",
  "identifier": "com.ripwords.starnetgui",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run ui:dev",
    "beforeBuildCommand": "bun run generate"
  },
  "app": {
    "windows": [
      {
        "title": "StarNet GUI",
        "width": 880,
        "height": 620,
        "minWidth": 680,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "GUI for StarNet2",
    "longDescription": "A graphical interface for the StarNet2 star removal command-line tool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ripwords/starnetGUI/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMDMzNzQxREFCREJFNEYKUldSUHZyM2FRVGNEWHBPOVliMzRMOVMrQ3FHTkQ0QmUxYkVsUEdtMVAwaUo2YWtsd2hsYytWREUK"
    }
  }
}
